{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rivierajourneys",
  "compatibility_date": "2026-04-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "_worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "REVIEWS_COUNT": "10",
    "REVIEWS_RATING": "5.0",
    "REVIEWS_BEST": "5"
  }
}
