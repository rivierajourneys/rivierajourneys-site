{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rivierajourneys",
  "compatibility_date": "2026-04-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "_worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  },
  "routes": [
    {
      "pattern": "rivierajourneys.fr",
      "custom_domain": true
    },
    {
      "pattern": "www.rivierajourneys.fr",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SCHEDULES",
      "id": "697d458fd6c042698f0ee12d7d8d8b25"
    }
  ]
}
